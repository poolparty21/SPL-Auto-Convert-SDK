{
  "name": "@kololabs/gas",
  "version": "1.0.1",
  "private": false,
  "description": "Gas estimation and fee management for the Kolo SPL Auto-Convert SDK",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit"
  },
  "peerDependencies": {
    "@solana/web3.js": ">=1.98.0"
  },
  "devDependencies": {
    "@solana/web3.js": "^1.98.0",
    "@types/node": "^22.0.0",
    "tsup": "^8.4.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/poolparty21/SPL-Auto-Convert-SDK.git",
    "directory": "packages/gas"
  }
}
