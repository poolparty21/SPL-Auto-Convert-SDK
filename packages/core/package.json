{
  "name": "@kololabs/core",
  "version": "0.1.1",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "typescript": "^5.8.0",
    "vitest": "^4.1.0",
    "@types/node": "^22.0.0",
    "tsup": "^8.3.0"
  },
  "dependencies": {
    "@kololabs/listener": "^0.1.1",
    "@kololabs/gas": "^0.1.1",
    "@kololabs/router": "^0.1.1"
  }
}
